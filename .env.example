# Octopus — variables d'environnement.
# Copie ce fichier en .env.local et remplis ce dont tu as besoin :
#   cp .env.example .env.local

# Clé Claude (Anthropic). Obligatoire pour : le copilote vocal (/bench/run/[runId]),
# la génération/adaptation de protocole par le LLM, l'interprétation du rapport
# (Auto Report) et le chat « Ask your lab » (/chat). Sans clé, `npm run seed`,
# les protocoles/runs/rapports (repli hors-ligne déterministe) et la navigation
# du Bench fonctionnent quand même — seule la prose générée par Claude manque.
ANTHROPIC_API_KEY=

# ── Assistant vocal temps réel (LiveKit) ─────────────────────────────────
# Prérequis une fois : `brew install livekit` (le serveur local), puis
# `npm run voice` dans un terminal à côté de `npm run dev`.

# Transcription streaming (STT). Tier gratuit : https://console.deepgram.com
DEEPGRAM_API_KEY=

# Synthèse vocale (TTS). Tier gratuit : https://elevenlabs.io
ELEVEN_API_KEY=
# Optionnel : ID d'une voix ElevenLabs (bibliothèque sur elevenlabs.io/voice-library).
# Vide = voix par défaut du modèle eleven_flash_v2_5.
ELEVEN_VOICE_ID=

# Optionnel : serveur LiveKit. Défauts = mode dev local (`livekit-server --dev`).
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Chemin du fichier SQLite (better-sqlite3). Optionnel : "octopus.db" par défaut,
# relatif à la racine du repo (fichiers WAL associés : octopus.db-shm / -wal).
OCTOPUS_DB_PATH=octopus.db

# ── Flags de brique (FEATURE_*) ──────────────────────────────────────────
# Posés à "true" automatiquement au chargement de lib/session.ts (une seule
# fois, si absents de l'environnement) : les 8 briques sont actives par défaut
# dans le repo standalone. Listés ici pour transparence — inutile de les
# définir toi-même, sauf pour désactiver une brique en particulier (poser la
# variable à autre chose que "true" ; le garde-fou est fail-closed).
# FEATURE_PROTOCOL_STUDIO=true
# FEATURE_WORKFLOW_BUILDER=true
# FEATURE_LIVE_BENCH=true
# FEATURE_EVIDENCE_CAPTURE=true
# FEATURE_AUTO_REPORT=true
# FEATURE_LAB_MEMORY=true
# FEATURE_VOICE_COPILOT=true
# FEATURE_KNOWLEDGE_GRAPH=true
